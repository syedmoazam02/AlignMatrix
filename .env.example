# Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./resumegpt.db
# For PostgreSQL in Docker: postgresql+psycopg2://postgres:postgres@db:5432/resumegpt

# AI / LLM Configuration
LLM_PROVIDER=mock  # Options: mock, openai
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
PROMPT_VERSION=v1.0.0

# Input Limits (Cost & Buffer Protection)
MAX_RESUME_CHARS=50000
MAX_JOB_DESCRIPTION_CHARS=30000

# Scoring Weights (Total must equal 1.00)
WEIGHT_SKILLS_MATCH=0.30
WEIGHT_EXPERIENCE_MATCH=0.25
WEIGHT_JOB_ALIGNMENT=0.20
WEIGHT_IMPACT_AND_ACHIEVEMENTS=0.15
WEIGHT_EDUCATION_MATCH=0.10

# CORS
CORS_ORIGINS=["http://localhost:3000"]
